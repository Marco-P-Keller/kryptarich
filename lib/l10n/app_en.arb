  "securityDetails": "Security details",
  "@securityDetails": {},
  "secIntro": "How Krypta protects your messages, from the device through delivery to the server. Everything here reflects how the app is actually built.",
  "@secIntro": {},
  "secMessagesTitle": "Message encryption",
  "@secMessagesTitle": {},
  "secMessagesBody": "Every message is encrypted on your device and only becomes readable again on your contact's device. Encryption and authentication happen in one step, with extra data bound into the seal: a modified message is rejected rather than decrypted.",
  "@secMessagesBody": {},
  "secExchangeTitle": "Key exchange",
  "@secExchangeTitle": {},
  "secExchangeBody": "On first contact both devices agree on a shared secret without ever transmitting it. Three Diffie-Hellman parts are combined and the session key is derived from them. The server only ever sees public keys.",
  "@secExchangeBody": {},
  "secForwardTitle": "Forward secrecy",
  "@secForwardTitle": {},
  "secForwardBody": "A fresh key is derived for every message and the old one is discarded. Anyone who steals a key can read neither earlier nor later messages. Missed messages catch up without giving that property away.",
  "@secForwardBody": {},
  "secIdentityTitle": "Identity and verification",
  "@secIdentityTitle": {},
  "secIdentityBody": "Each device has an identity key pair. Prekeys and transparency entries are signed, so a server cannot swap them unnoticed. The safety number is computed from both identities and is the same on both devices.",
  "@secIdentityBody": {},
  "secPasswordTitle": "Passwords and codes",
  "@secPasswordTitle": {},
  "secPasswordBody": "Passwords and codes are never stored, only their derivation. The method is deliberately slow and memory-hungry so attempts cannot be run in bulk.",
  "@secPasswordBody": {},
  "secLocalTitle": "On the device",
  "@secLocalTitle": {},
  "secLocalBody": "Messages and keys are stored encrypted in the app's own storage. The master key lives in the operating system keychain and is readable only after the device has been unlocked once. Where available, it is additionally wrapped by a security chip.",
  "@secLocalBody": {},
  "secServerTitle": "Server and delivery",
  "@secServerTitle": {},
  "secServerBody": "The server accepts encrypted envelopes and forwards them. It never holds a key and never sees content. Delivery uses a short-lived identifier of the recipient. Delivered envelopes are removed.",
  "@secServerBody": {},
  "secTransportTitle": "Transport",
  "@secTransportTitle": {},
  "secTransportBody": "The connection is encrypted and the app accepts only the expected certificates. This is enforced at the operating system level and therefore covers every connection the app makes.",
  "@secTransportBody": {},
  "secFooter": "These statements describe methods and parameters, never keys. They apply to the version shown above.",
  "@secFooter": {}
}
