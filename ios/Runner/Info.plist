<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
	<!-- Springboard, app switcher, Settings.app and the share sheet all read
	     these. Deliberately the PRODUCT name, not a calculator cover name —
	     decided 2026-08-24: customers should recognise the app they installed,
	     and the App Store listing says "Krypta Chat" anyway, so a cover name on
	     the home screen only bought half a disguise. The calculator in front of
	     the passcode is an unlock gate, not a disguise. Reversing this needs the
	     store listing renamed too, otherwise it is the same half measure.
	     Whatever is set here must not collide with another developer's app name
	     or Apple rejects the build in processing (ITMS-90129) — after upload,
	     not during validation. scripts/asc_app_state.py check-names guards it;
	     the own store name is allowed. Localized in Runner/en.lproj +
	     Runner/de.lproj InfoPlist.strings. -->
	<key>CFBundleDisplayName</key>
	<string>Krypta Chat</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Krypta Chat</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks the app without typing your passcode.</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used to scan a QR code for pairing.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photo access is used to import a pairing QR code you already saved.</string>
	<!-- Only modes the app actually implements may be declared (2.5.4).
	     Message wake-up runs over silent pushes; there is no background fetch
	     handler, so `fetch` is not declared. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Security: Enforce ATS (HTTPS only, TLS 1.2+) + certificate pinning.
	     NSPinnedDomains pins Firebase/Google intermediate CAs (iOS 14+).
	     Equivalent to Android's network_security_config.xml pin-set. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSPinnedDomains</key>
		<dict>
			<key>firebaseio.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSPinnedCAIdentities</key>
				<array>
					<!-- GTS Root R1 (primary Google CA) -->
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</string>
					</dict>
					<!-- GTS Root R4 (backup pin) -->
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</string>
					</dict>
				</array>
			</dict>
			<key>googleapis.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSPinnedCAIdentities</key>
				<array>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</string>
					</dict>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</string>
					</dict>
				</array>
			</dict>
		</dict>
	</dict>
	<!-- Encryption export compliance: the app uses the Signal Protocol (X3DH +
	     Double Ratchet + XChaCha20-Poly1305) as a core feature.

	     ITSAppUsesNonExemptEncryption is deliberately ABSENT. It used to be set
	     to <true/> with the note "handle the questionnaire in App Store Connect"
	     — but that combination does the opposite: with the key set to true and
	     no ITSEncryptionExportComplianceCode next to it, altool rejects the
	     upload outright (ITMS-90592). It never reaches the questionnaire.
	     That went unnoticed because earlier builds were uploaded from Xcode on
	     a Mac, which asks interactively; CI validates strictly.

	     With the key absent, Apple asks about encryption per build in App Store
	     Connect, which is what the original note intended. Answer it there.

	     Do NOT set this to <false/> just to make an upload pass. That is a
	     declaration under US export regulations, not a build setting, and for
	     an end-to-end encrypted messenger it is not ours to guess.
	     See docs/TESTFLIGHT_GITHUB_ACTIONS.md, section 9. -->
</dict>
</plist>
